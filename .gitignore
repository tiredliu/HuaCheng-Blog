# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files —— 但保留模板，方便别人 clone 之后照着填
.env*
!.env.example

# vercel / cloudflare
.vercel
.wrangler

# typescript
*.tsbuildinfo
next-env.d.ts

# TinaCMS 生成物（tina-lock.json 要提交，__generated__ 不要）
/tina/__generated__
/public/admin

# TinaCMS CLI 的编译临时目录（见 scripts/tina.mjs）
/.tina-tmp

# 上传的媒体文件按需提交，默认不忽略
!public/uploads
