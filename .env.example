# ---------------------------------------------------------------------------
# 复制成 .env.local 之后填写（.env.local 不会提交到 Git）
# ---------------------------------------------------------------------------

# TinaCMS 后台开关。
# true  = 使用本地文件系统（本地开发，不需要 TinaCloud 账号）
# false = 使用 TinaCloud，线上写作时用
TINA_PUBLIC_IS_LOCAL=true

# 在 https://app.tina.io 创建项目后拿到，用于线上的可视化编辑
NEXT_PUBLIC_TINA_CLIENT_ID=

# TinaCloud 的只读 Token（令牌选项卡里新建时选 Read Only）。
# 写权限来自你在 /admin 里的登录会话，不需要读写 token。
# 建 token 时把「Git 分支」填成 main。
TINA_TOKEN=

# TinaCMS 把内容提交到哪个分支，默认 main
GITHUB_BRANCH=main
