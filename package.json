{
  "name": "hua-cheng-blog",
  "version": "1.0.0",
  "private": true,
  "description": "花城博客 · Next.js 静态导出 + MDX + TinaCMS",
  "scripts": {
    "dev": "cross-env TINA_PUBLIC_IS_LOCAL=true node scripts/tina.mjs dev -c \"next dev\"",
    "dev:next": "next dev",
    "new": "node scripts/new-post.mjs",
    "lyrics": "node scripts/import-lyrics.mjs",
    "build": "node scripts/tina.mjs build && next build",
    "build:cms": "node scripts/tina.mjs build",
    "build:app": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.8",
    "@shikijs/rehype": "^4.5.0",
    "@types/mdx": "^2.0.14",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.19.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.5.0",
    "tinacms": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tinacms/cli": "^2.3.1",
    "@types/node": "^20.19.41",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
